# Separate maintained forks/modules, not disposable source. Commit/push inside each
# affected repo too; exact published revisions are recorded in repo-pins.txt.
azerothcore-wotlk/

# Client addons are fetched by fetch-client-addons.sh.
client-addons/
client-addons.zip

# Database backups produced by backup.sh.
backups/

# Host-only immutable Lua revisions, instance mailboxes/status and offline checker.
runtime/playerbot-policies/
runtime/playerbot-policy-status/
runtime/playerbot-policy-checker/

# Local env / secrets
.env
.env.pre-restore
*.local

# Compiled ac-webreg binary (built into a container by setup.sh on the server)
webreg/acore-webreg

# Python sidecar: local virtualenv and bytecode cache
lore-sidecar/.venv/
**/__pycache__/
*.pyc
