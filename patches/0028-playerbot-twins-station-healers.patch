diff --git a/modules/mod-playerbots/src/Ai/Raid/Aq40/Aq40Coordination.cpp b/modules/mod-playerbots/src/Ai/Raid/Aq40/Aq40Coordination.cpp
--- a/modules/mod-playerbots/src/Ai/Raid/Aq40/Aq40Coordination.cpp
+++ b/modules/mod-playerbots/src/Ai/Raid/Aq40/Aq40Coordination.cpp
@@ -190,18 +190,29 @@
     if (!IsTwinsEncounterActive(bot) || !bot->IsAlive() || !PlayerbotAI::IsHeal(bot))
         return nullptr;
     uint32 const assignment = DedicatedHealerData(bot);
-    Player* melee = GetTwinsTank(bot, AQT_DATA_VEKNILASH);
+    // Undo the boss-ownership swap when selecting the two physical station anchors.
