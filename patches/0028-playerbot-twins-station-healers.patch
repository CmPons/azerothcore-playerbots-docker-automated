+    bool const swapped = GetTwinsSnapshot(bot).meleeAtCasterHome;
+    Player* firstStation = GetTwinsTank(bot, AQT_DATA_VEKNILASH, swapped);
+    Player* secondStation = GetTwinsTank(bot, AQT_DATA_VEKNILASH, !swapped);
     Player* caster = GetTwinsTank(bot, AQT_DATA_VEKLOR);
-    if (!melee || !caster)
-        return melee ? melee : caster;
     if (assignment)
-        return assignment == AQT_DATA_VEKNILASH ? melee : caster;
-
-    // Floating coverage includes the actual victims: the stationary physical tank may be
-    // holding incoming Shadow Bolts while the warlock travels. Do not leave that handoff unhealed.
+    {
+        Player* station = assignment == AQT_DATA_VEKNILASH ? firstStation : secondStation;
+        if (station)
+            return station;
+        return firstStation ? firstStation : secondStation ? secondStation : caster;
+    }
+
+    // The additional healer supports the travelling caster tank. Ordinary healing triage still
