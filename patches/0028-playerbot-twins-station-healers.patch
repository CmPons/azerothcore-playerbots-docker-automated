+    if (caster)
+        return caster;
+
+    // If no caster tank survives, cover remaining stations and actual temporary victims.
     Creature* vn = GetTwin(bot, AQT_DATA_VEKNILASH);
     Creature* vl = GetTwin(bot, AQT_DATA_VEKLOR);
