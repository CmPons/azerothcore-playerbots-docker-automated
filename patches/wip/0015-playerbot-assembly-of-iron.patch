+// Cross-class taunt spell ids for the Assembly of Iron off-tank taunt (same values as the ICC dogs
+// idiom). ULDUAR_-prefixed to avoid a same-scope redefinition clash with ICCTriggers.h's
+// SPELL_TAUNT_* enum constants (the module build compiles a TU that sees both headers).
+constexpr uint32 ULDUAR_TAUNT_WARRIOR = 355;
+constexpr uint32 ULDUAR_TAUNT_PALADIN = 62124;  // Hand of Reckoning
+constexpr uint32 ULDUAR_TAUNT_DK = 56222;       // Dark Command
+constexpr uint32 ULDUAR_TAUNT_DRUID = 6795;     // Growl
+
+// The Assembly off-tank holds its two non-kill bosses at least this far from the main tank, so
+// Brundir's Overload (radius ~20-25y per the non-tank dodge) never reaches the main tank / DPS
+// cluster on the kill target. Tunable if live testing shows Overload reaching further.
+constexpr float ULDUAR_ASSEMBLY_OFFTANK_SEPARATION = 30.0f;
+
+// Resolve a living Assembly of Iron council member by creature entry near the bot.
+//
+// Unlike AI_VALUE2(Unit*, "find target", "<name>") — which scans ONLY the bot's threat list
+// (TargetValue.cpp) and returns null the instant Brundir CombatStop()s for Lightning Tendrils —
+// this searches the world, so the tendrils/overload dodges keep firing through the CombatStop.
+// Bots are always within a few dozen yards of the council, so the ~533y grid-search clamp and the
+// 100y range are irrelevant. Returns nullptr if not found or dead.
+inline Unit* GetAssemblyMember(Player* bot, uint32 entry)
+{
+    if (!bot)
+        return nullptr;
+    return bot->FindNearestCreature(entry, 100.0f);  // alive=true by default
+}
+
+// Highest-priority LIVING Assembly boss in kill order: Steelbreaker -> Molgeim -> Brundir.
+// Returns nullptr when none are alive/near. GetAssemblyMember already filters to alive.
+inline Unit* GetAssemblyKillTarget(Player* bot)
+{
+    if (Unit* steelbreaker = GetAssemblyMember(bot, NPC_STEELBREAKER_ENTRY))
+        return steelbreaker;
+    if (Unit* molgeim = GetAssemblyMember(bot, NPC_MOLGEIM_ENTRY))
+        return molgeim;
+    if (Unit* brundir = GetAssemblyMember(bot, NPC_BRUNDIR_ENTRY))
+        return brundir;
+    return nullptr;
+}
