+bool IronAssemblyRuneOfDeathAction::isUseful()
+{
+    IronAssemblyRuneOfDeathTrigger trigger(botAI);
+    return trigger.IsActive();
+}
+
+bool IronAssemblyRuneOfDeathAction::Execute(Event /*event*/)
+{
+    Aura* areaDebuff = AI_VALUE(Aura*, "area debuff");
+    if (!areaDebuff)
+        return false;
+
+    DynamicObject* dyn = areaDebuff->GetDynobjOwner();
+    if (!dyn || !dyn->IsInWorld())
+        return false;
+
+    float radius = dyn->GetRadius();
+    if (bot->GetDistance(dyn) > radius)
+        return false;
+
+    // Flee the rune center; the tanked boss follows the tank, kiting it off the rune. +3y margin
+    // (like the tendrils/overload vacate) so the tank clears the rune edge rather than clipping it.
+    return FleePosition(dyn->GetPosition(), radius + 3.0f);
+}
+
+bool IronAssemblyStaticDisruptionAction::isUseful()
+{
+    IronAssemblyStaticDisruptionTrigger trigger(botAI);
+    return trigger.IsActive();
+}
+
+bool IronAssemblyStaticDisruptionAction::Execute(Event /*event*/)
+{
+    GuidVector members = AI_VALUE(GuidVector, "group members");
+    Unit* closest = nullptr;
+    float best = 7.0f;
+    for (ObjectGuid const& guid : members)
+    {
+        Unit* member = botAI->GetUnit(guid);
+        if (!member || member == bot || !member->IsAlive())
+            continue;
+        if (!(member->HasAura(SPELL_STATIC_DISRUPTION_10_MAN) || member->HasAura(SPELL_STATIC_DISRUPTION_25_MAN)))
+            continue;
+        float d = bot->GetDistance(member);
+        if (d < best)
+        {
+            best = d;
+            closest = member;
+        }
+    }
+    if (!closest)
+        return false;
+
+    return MoveAway(closest, 7.0f - best);
+}
+
