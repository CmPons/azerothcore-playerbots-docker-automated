+
+bool IronAssemblyMarkKillOrderAction::Execute(Event /*event*/)
+{
+    // Only a tank drives the raid mark (DPS + main tank hard-focus the skull).
+    if (!botAI->IsTank(bot))
+        return false;
+
+    Group* group = bot->GetGroup();
+    if (!group)
+        return false;
+
+    Unit* killTarget = GetAssemblyKillTarget(bot);
+    if (!killTarget)
+        return false;
+
+    // Advance the skull to the current kill target (Steelbreaker -> Molgeim -> Brundir).
+    int8 skullIndex = 7;  // Skull
+    group->SetTargetIcon(skullIndex, bot->GetGUID(), killTarget->GetGUID());
+    return true;
+}
+
+bool IronAssemblyOffTankTauntAction::isUseful()
+{
+    IronAssemblyOffTankTauntTrigger trigger(botAI);
+    return trigger.IsActive();
+}
+
+bool IronAssemblyOffTankTauntAction::Execute(Event /*event*/)
+{
+    // Off-tanks only: the main tank holds the kill target.
+    if (!botAI->IsTank(bot) || botAI->IsMainTank(bot))
+        return false;
+
+    Unit* killTarget = GetAssemblyKillTarget(bot);
+
+    // Cross-class taunt (verbatim from ICCActions_Dogs.cpp's CastClassTaunt): reset the class
+    // taunt cooldown then cast it, with a ranged shoot/throw fallback for classes without one.
+    auto CastClassTaunt = [&](Unit* target) -> bool
+    {
+        if (!target || !target->IsAlive())
+            return false;
+
+        switch (bot->getClass())
+        {
+            case CLASS_PALADIN:
+            {
+                bot->RemoveSpellCooldown(ULDUAR_TAUNT_PALADIN, true);
+                if (botAI->CastSpell("hand of reckoning", target))
+                    return true;
+                break;
+            }
+            case CLASS_DEATH_KNIGHT:
+            {
+                bot->RemoveSpellCooldown(ULDUAR_TAUNT_DK, true);
+                if (botAI->CastSpell("dark command", target))
+                    return true;
+                break;
+            }
+            case CLASS_DRUID:
+            {
+                bot->RemoveSpellCooldown(ULDUAR_TAUNT_DRUID, true);
+                if (botAI->CastSpell("growl", target))
+                    return true;
+                break;
+            }
+            case CLASS_WARRIOR:
+            {
+                bot->RemoveSpellCooldown(ULDUAR_TAUNT_WARRIOR, true);
+                if (botAI->CastSpell("taunt", target))
+                    return true;
+                break;
+            }
+            default:
+                break;
+        }
+
+        if (botAI->CastSpell("shoot", target) || botAI->CastSpell("throw", target))
+            return true;
+
+        return false;
+    };
+
+    // Taunt every living non-kill boss this off-tank has not yet peeled. Taunting both each
+    // execution (with the cooldown reset) is how one off-tank holds two — intended.
+    bool taunted = false;
+    uint32 const entries[] = {NPC_STEELBREAKER_ENTRY, NPC_MOLGEIM_ENTRY, NPC_BRUNDIR_ENTRY};
+    for (uint32 entry : entries)
+    {
+        Unit* boss = GetAssemblyMember(bot, entry);
+        if (!boss)
+            continue;
+        if (killTarget && boss == killTarget)
+            continue;
+        if (boss->GetVictim() == bot)
+            continue;
+        if (CastClassTaunt(boss))
+            taunted = true;
+    }
+    return taunted;
+}
+
+bool IronAssemblyOffTankSeparateAction::isUseful()
+{
+    IronAssemblyOffTankSeparateTrigger trigger(botAI);
+    return trigger.IsActive();
+}
+
+bool IronAssemblyOffTankSeparateAction::Execute(Event /*event*/)
+{
+    Unit* mainTank = AI_VALUE(Unit*, "main tank");
+    if (!mainTank || mainTank == bot)
+        return false;
+
+    float dist = bot->GetDistance(mainTank);
+    if (dist >= ULDUAR_ASSEMBLY_OFFTANK_SEPARATION)
+        return false;
+
+    // Move away from the main tank; the held bosses (Molgeim + Brundir) follow via aggro, pulling
+    // Brundir's Overload radius off the main tank and the DPS cluster on the kill target.
+    return MoveAway(mainTank, ULDUAR_ASSEMBLY_OFFTANK_SEPARATION - dist);
+}
