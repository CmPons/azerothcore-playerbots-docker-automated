+bool IronAssemblyRuneOfDeathTrigger::IsActive()
+{
+    // Tank-only: non-tanks flee via generic "avoid aoe"; the tank kites the boss off the rune.
+    if (!botAI->IsTank(bot))
+        return false;
+
+    // Cheap gate FIRST: "area debuff" is a cached, negative-dynobj-only value, so Rune of Power
+    // (positive) is excluded and on this encounter the only such rune under the tank is Rune of
+    // Death. Check it before any world search — this trigger runs every react tick per tank bot,
+    // and CLAUDE.md warns against per-tick grid queries on the map-update thread.
+    if (AI_VALUE(Aura*, "area debuff") == nullptr)
+        return false;
+
+    // Only while tanking a living Assembly member. GetAssemblyMember already filters to alive.
+    Unit* boss = GetAssemblyMember(bot, NPC_STEELBREAKER_ENTRY);
+    if (!boss)
+        boss = GetAssemblyMember(bot, NPC_MOLGEIM_ENTRY);
+    if (!boss)
+        boss = GetAssemblyMember(bot, NPC_BRUNDIR_ENTRY);
+
+    return boss != nullptr;
+}
+
+bool IronAssemblyStaticDisruptionTrigger::IsActive()
+{
+    // Tank stays put (moving would drop the boss); only spreaders react.
+    if (botAI->IsTank(bot))
+        return false;
+
+    // Only while Steelbreaker (the caster) is up.
+    Unit* steelbreaker = GetAssemblyMember(bot, NPC_STEELBREAKER_ENTRY);
+    if (!steelbreaker || !steelbreaker->IsAlive())
+        return false;
+
+    GuidVector members = AI_VALUE(GuidVector, "group members");
+    for (ObjectGuid const& guid : members)
+    {
+        Unit* member = botAI->GetUnit(guid);
+        if (!member || member == bot || !member->IsAlive())
+            continue;
+        if ((member->HasAura(SPELL_STATIC_DISRUPTION_10_MAN) || member->HasAura(SPELL_STATIC_DISRUPTION_25_MAN))
+            && bot->GetDistance(member) < 7.0f)
+            return true;
+    }
+    return false;
+}
+
+bool IronAssemblyMarkKillOrderTrigger::IsActive()
+{
+    // Only a tank drives the raid mark — gate BEFORE GetAssemblyKillTarget so non-tank raid bots
+    // don't each run grid searches every react tick (per CLAUDE.md's per-tick-world-query caution).
+    if (!botAI->IsTank(bot))
+        return false;
+
+    // Need the group to read/advance the skull mark.
+    Group* group = bot->GetGroup();
+    if (!group)
+        return false;
+
+    // The living kill target in order Steelbreaker -> Molgeim -> Brundir.
+    Unit* killTarget = GetAssemblyKillTarget(bot);
+    if (!killTarget)
+        return false;
+
+    // Fire only when the skull needs updating — idempotent, no per-tick spam / re-mark loop.
+    int8 skullIndex = 7;  // Skull
+    return group->GetTargetIcon(skullIndex) != killTarget->GetGUID();
+}
+
+bool IronAssemblyOffTankTauntTrigger::IsActive()
+{
+    // Off-tanks only: the main tank holds the kill target; off-tanks peel the other two.
+    // Assumes a 2-tank comp (the Council is normally two-tanked): with only ONE tank alive it is
+    // the main tank, this never engages, and the two non-kill bosses stay on the main tank.
+    if (!botAI->IsTank(bot) || botAI->IsMainTank(bot))
+        return false;
+
+    Unit* killTarget = GetAssemblyKillTarget(bot);
+
+    // True if any living non-kill boss is not already tanked by this off-tank.
+    uint32 const entries[] = {NPC_STEELBREAKER_ENTRY, NPC_MOLGEIM_ENTRY, NPC_BRUNDIR_ENTRY};
+    for (uint32 entry : entries)
+    {
+        Unit* boss = GetAssemblyMember(bot, entry);
+        if (!boss)
+            continue;
+        if (killTarget && boss == killTarget)
+            continue;
+        if (boss->GetVictim() == bot)
+            continue;
+        return true;
+    }
+    return false;
+}
+
+bool IronAssemblyOffTankSeparateTrigger::IsActive()
+{
+    // Off-tanks only: separate the two bosses this tank holds away from the main tank so Brundir's
+    // Overload does not reach the main tank / kill-target cluster.
+    if (!botAI->IsTank(bot) || botAI->IsMainTank(bot))
+        return false;
+
+    Unit* mainTank = AI_VALUE(Unit*, "main tank");
+    if (!mainTank || mainTank == bot)
+        return false;
+
+    // Only once actually holding a non-kill boss (peel first — the taunt action is higher priority).
+    Unit* killTarget = GetAssemblyKillTarget(bot);
+    bool holding = false;
+    uint32 const entries[] = {NPC_STEELBREAKER_ENTRY, NPC_MOLGEIM_ENTRY, NPC_BRUNDIR_ENTRY};
+    for (uint32 entry : entries)
+    {
+        Unit* boss = GetAssemblyMember(bot, entry);
+        if (!boss)
+            continue;
+        if (killTarget && boss == killTarget)
+            continue;
+        if (boss->GetVictim() == bot)
+        {
+            holding = true;
+            break;
+        }
+    }
+    if (!holding)
+        return false;
+
+    // Too close to the main tank -> reposition (the held bosses follow via aggro).
+    return bot->GetDistance(mainTank) < ULDUAR_ASSEMBLY_OFFTANK_SEPARATION;
+}
