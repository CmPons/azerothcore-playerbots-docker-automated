+float HeiganDanceMultiplier::GetValue(Action* action)
+{
+    Unit* boss = AI_VALUE2(Unit*, "find target", "heigan the unclean");
+    if (!boss)
+        return 1.0f;
+
+    // The dance movement always wins.
+    if (dynamic_cast<HeiganDanceAction*>(action))
+        return 1.0f;
+
+    // Never let these drag a bot off the safe band.
+    if (dynamic_cast<CombatFormationMoveAction*>(action) ||
+        dynamic_cast<FleeAction*>(action) ||
+        dynamic_cast<CastDisengageAction*>(action) ||
+        dynamic_cast<CastBlinkBackAction*>(action))
+        return 0.0f;
+
+    // Fast dance is survival-only: drop non-instant DPS casts (they root the
+    // bot). Heals and cures MUST still go through, or the raid dies unhealed
+    // while everyone runs the dance.
+    if (helper.UpdateBossAI() && helper.IsFastDance())
+    {
+        if (dynamic_cast<CastHealingSpellAction*>(action) ||
+            dynamic_cast<CurePartyMemberAction*>(action))
+            return 1.0f;
+
+        CastSpellAction* spellAction = dynamic_cast<CastSpellAction*>(action);
+        if (spellAction && !dynamic_cast<CastMeleeSpellAction*>(action))
+        {
+            uint32 spellId =
+                AI_VALUE2(uint32, "spell id", spellAction->getSpell());
+            SpellInfo const* spellInfo = sSpellMgr->GetSpellInfo(spellId);
+            if (!spellInfo)
+                return 0.0f;
+
+            if (spellInfo->CalcCastTime() > 0 || spellInfo->IsChanneled())
+                return 0.0f;
+        }
+    }
+    return 1.0f;
+}
 
